// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": "Light Charmed Icons",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Soft",
    "dark": "Zedokai Darker (Filter Spectrum)",
  },

  "theme_overrides": {
    "Zedokai Darker (Filter Spectrum)": {
      "editor.document_highlight.read_background": "#000000",
      "editor.document_highlight.write_background": "#000000",
      "border.variant": "#222222",
      "border": "#222222",
      "title_bar.background": "#222222",
      // "panel.background": "#EF4444",
      // "panel.focused_border": "#4E466E",
      "players": [
        {
          "cursor": "#EF4444",
        },
      ],
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },

  "title_bar": {
    // "show_onboarding_banner": false,
    // "show_project_items": false,
    "show_branch_name": false,
    // "show_user_menu": false,
  },

  "tab_bar": {
    "show": false,
  },

  "toolbar": {
    "quick_actions": false,
  },

  "status_bar": {
    "experimental.show": false,
  },

  "project_panel": {
    "dock": "right",
    "default_width": 300,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    // "git_status": false,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },

  "outline_panel": {
    "default_width": 300,
    "indent_guides": {
      "show": "never",
    },
  },

  "file_finder": {
    "modal_max_width": "large",
  },

  "scrollbar": {
    "show": "never",
  },

  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false,
  },

  "indent_guides": {
    // "enabled": false,
  },

  // "ui_font_family": "FiraCode Nerd Font Mono",
  // "ui_font_size": 20,
  // "buffer_font_family": "FiraCode Nerd Font Mono",
  // "buffer_font_size": 20,
  "buffer_line_height": {
    "custom": 2,
  },

  // "vim_mode": false
  // "multi_cursor_modifier": "cmd_or_ctrl",
  // "cursor_shape":"block",
  // "cursor_blink": false,
  "selection_highlight": false,
  // "drag_and_drop_selection": {
  //   "enabled": false,
  // },
  // "seed_search_query_from_cursor": "never"
  "current_line_highlight": "gutter",
  "show_whitespaces": "none",
  "tab_size": 2,

  // "auto_indent": false,

  "auto_indent_on_paste": false,
  "show_completions_on_input": false,
  "inline_code_actions": false,
  "lsp_document_colors": "none",
  // "hover_popover_enabled": false,
  // "format_on_save": "off",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "auto_update": false,
  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 1,
  // "when_closing_with_on_tabs": "keep_window_open",
  "close_on_file_delete": true,
  "restore_on_file_reopen": false,
  "restore_on_startup": "empty_tab",
  "session": {
    "restore_unsaved_buffers": false,
  },
  // "git": {
  //     "git_gutter": "hide",
  //     "inline_blame": {
  //       "enabled": false,
  //     },
  //   },
  // "centered_layout": {
  //   "right_padding": 0.15,
  //   "left_padding": 0.15,
  // },
}
